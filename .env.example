MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=olympic_dataset
MYSQL_USER=
MYSQL_PASSWORD=
SOURCE_URL=

# Broker address. Required for Spark jobs; create_topics falls back to .kcat-goit.conf.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Replace myname with your assigned prefix on the shared cluster.
KAFKA_INPUT_TOPIC=myname_athlete_event_results
KAFKA_OUTPUT_TOPIC=myname_athlete_avg_stats
