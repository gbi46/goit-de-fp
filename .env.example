MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=olympic_dataset
MYSQL_USER=
MYSQL_PASSWORD=
SOURCE_URL=

# Optional broker override for create_topics. Defaults to .kcat-goit.conf.
KAFKA_BOOTSTRAP_SERVERS=

# Replace myname with your assigned prefix on the shared cluster.
KAFKA_INPUT_TOPIC=myname_athlete_event_results
KAFKA_OUTPUT_TOPIC=myname_athlete_avg_stats
