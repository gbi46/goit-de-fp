MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=olympic_dataset
MYSQL_USER=
MYSQL_PASSWORD=
SOURCE_URL=

# Broker address. Required for Spark jobs; create_topics falls back to .kcat-goit.conf.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# auto: use the remote broker, or a local Docker Kafka when it is unreachable.
# remote / local: always use that broker.
KAFKA_MODE=auto

# Replace myname with your assigned prefix on the shared cluster.
KAFKA_INPUT_TOPIC=myname_athlete_event_results
KAFKA_OUTPUT_TOPIC=myname_athlete_avg_stats

# MySQL table for streaming_pipeline output (same host and user as above).
OUTPUT_MYSQL_DATABASE=neo_data
# Add your name: the neo_data database is shared.
OUTPUT_MYSQL_TABLE=myname_athlete_enriched_agg

# Stream duration for ./run.sh part1_demo, in seconds.
STREAM_RUN_SECONDS=300
