MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=olympic_dataset
MYSQL_USER=
MYSQL_PASSWORD=
SOURCE_URL=

# Kafka broker addresses, separated by commas (host:port).
KAFKA_BOOTSTRAP_SERVERS=

# Replace myname with your assigned prefix on the shared cluster.
KAFKA_INPUT_TOPIC=myname_athlete_event_results
KAFKA_OUTPUT_TOPIC=myname_athlete_avg_stats

# Path to a local Java Kafka client properties file for kafka-topics.sh.
# Keep the file outside the repository if it contains credentials.
KAFKA_CLIENT_CONFIG=
